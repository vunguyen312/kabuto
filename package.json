{
  "name": "zector-editor",
  "productName": "zector-editor",
  "version": "1.0.0",
  "description": "Simple text editor",
  "main": ".webpack/main",
  "build": {
    "appId": "io.github.vunguyen312.zector",
    "productName": "MyApp",
    "mac": {
      "icon": "build/icon.icns"
    },
    "win": {
      "icon": "build/icon.ico"
    },
    "linux": {
      "icon": "build"
    }
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ext .ts,.tsx ."
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-webpack": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "css-loader": "^6.11.0",
    "electron": "^39.8.10",
    "eslint": "^10.8.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "html-webpack-plugin": "^5.6.5",
    "node-loader": "^2.0.0",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.1",
    "typescript": "~4.9.5",
    "typescript-eslint": "^8.65.0"
  },
  "keywords": [],
  "author": {
    "name": "vunguyen312",
    "email": "vunguyen312@outlook.com"
  },
  "license": "MIT",
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  },
  "overrides": {
    "@electron/asar": "4.0.1",
    "@electron/rebuild": "4.2.0",
    "asar": "npm:@electron/asar@4.0.1",
    "fork-ts-checker-webpack-plugin": {
      "minimatch": "10.2.5"
    },
    "@inquirer/editor": "4.2.23",
    "minimatch": "10.2.5",
    "temp": {
      "rimraf": "6.0.1"
    },
    "tmp": "0.2.7",
    "webpack-dev-server": "6.0.0"
  }
}
